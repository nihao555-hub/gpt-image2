# Copy to .env and fill in your key. Never commit the real .env.
# Your grsai API key (sent as "Authorization: Bearer <key>").
GRSAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides:
# Overseas host (default) or mainland-China direct host:
#   https://grsaiapi.com  |  https://grsai.dakka.com.cn
GRSAI_BASE_URL=https://grsaiapi.com
GRSAI_MODEL=gpt-image-2
